From be6b60cf9f1a77de1462c08c7e96d262b748c0ff Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?V=C3=A1clav=20Pavl=C3=ADn?= <vaclav.pavlin@gmail.com>
Date: Wed, 7 Oct 2026 06:36:56 +0200
Subject: [PATCH] media: i2c: ov8856: don't reset the Bayer order on open and
 G_FMT

ov8856_update_pad_format() stores the index of the media bus code it
resolves in ov8856->cur_mbus_index, falling back to the mode's default
code when the requested one is unknown. It is called for the TRY format
initialised in the subdev .open() handler and for the ACTIVE format in
.get_fmt() with a zero code, so every open of the subdev node and every
VIDIOC_SUBDEV_G_FMT silently reverted the Bayer order selected by
.set_fmt() to the mode default, while .get_fmt() reported that default.
The hardware then streamed a different Bayer order than the one
configured on the link, and media pipeline validation failed with
-EPIPE (seen with libcamera, which opens the sensor subdev more than
once).

Only update cur_mbus_index from an ACTIVE .set_fmt(), and report the
active code from .get_fmt().

Fixes: f1363166f91e ("media: ov8856: Set default mbus format but allow caller to alter")
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/media/i2c/ov8856.c | 21 +++++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/drivers/media/i2c/ov8856.c b/drivers/media/i2c/ov8856.c
index 8bedb47..d6e898b 100644
--- a/drivers/media/i2c/ov8856.c
+++ b/drivers/media/i2c/ov8856.c
@@ -1990,10 +1990,19 @@ static void ov8856_update_pad_format(struct ov8856 *ov8856,
 	if (index == ARRAY_SIZE(ov8856_mbus_codes))
 		index = mode->default_mbus_index;
 	fmt->code = ov8856_mbus_codes[index];
-	ov8856->cur_mbus_index = index;
 	fmt->field = V4L2_FIELD_NONE;
 }
 
+static u32 ov8856_mbus_index(u32 code)
+{
+	u32 index;
+
+	for (index = 0; index < ARRAY_SIZE(ov8856_mbus_codes); ++index)
+		if (ov8856_mbus_codes[index] == code)
+			return index;
+	return 0;
+}
+
 static int ov8856_start_streaming(struct ov8856 *ov8856)
 {
 	const struct ov8856_reg_list *reg_list;
@@ -2150,6 +2159,11 @@ static int ov8856_set_format(struct v4l2_subdev *sd,
 		*v4l2_subdev_state_get_format(sd_state, fmt->pad) = fmt->format;
 	} else {
 		ov8856->cur_mode = mode;
+		/*
+		 * Only an ACTIVE set_fmt selects the Bayer order; TRY formats,
+		 * G_FMT and subdev open() must not change it.
+		 */
+		ov8856->cur_mbus_index = ov8856_mbus_index(fmt->format.code);
 		__v4l2_ctrl_s_ctrl(ov8856->link_freq, mode->link_freq_index);
 		__v4l2_ctrl_s_ctrl_int64(ov8856->pixel_rate,
 					 to_rate(ov8856->priv_lane->link_freq_menu_items,
@@ -2187,8 +2201,11 @@ static int ov8856_get_format(struct v4l2_subdev *sd,
 	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
 		fmt->format = *v4l2_subdev_state_get_format(sd_state,
 							    fmt->pad);
-	else
+	else {
+		/* report the active Bayer order, not the mode default */
+		fmt->format.code = ov8856_mbus_codes[ov8856->cur_mbus_index];
 		ov8856_update_pad_format(ov8856, ov8856->cur_mode, &fmt->format);
+	}
 
 	mutex_unlock(&ov8856->mutex);
 
-- 
2.55.0

