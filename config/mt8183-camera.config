# Kernel config fragment for the MT8183 camera path (tested on 6.12.50, arm64).
# Merge with scripts/kconfig/merge_config.sh or append and run `make olddefconfig`.

# media core (usually already set by distro / Chromebook configs)
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=m
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_V4L2_FWNODE=m
CONFIG_VIDEOBUF2_DMA_CONTIG=m
CONFIG_MTK_IOMMU=y
CONFIG_MTK_SMI=y
CONFIG_GENERIC_PHY=y
CONFIG_COMMON_CLK_MT8183_CAMSYS=y

# sensors / lens on kukui-krane (IdeaPad Duet)
CONFIG_VIDEO_CAMERA_SENSOR=y
CONFIG_VIDEO_OV8856=m
CONFIG_VIDEO_OV02A10=m
CONFIG_VIDEO_DW9768=m

# libcamera's software ISP needs a dma-buf provider (all three are bool)
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_UDMABUF=y

# In-tree alternative to the out-of-tree PHY module in this repo:
# CONFIG_PHY_MTK_MIPI_CSI_0_5=m   (needs the mt8183 compatible patch)

# NOT a Kconfig option: the subdev streams/routing uAPI must be enabled in
# drivers/media/v4l2-core/v4l2-subdev.c, see patches/linux/v6.12/0002-*.patch
